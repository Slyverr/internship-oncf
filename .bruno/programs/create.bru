meta {
  name: create
  type: http
  seq: 1
  tags: [
    Programs
  ]
}

post {
  url: {{baseUrl}}/programs
  body: json
  auth: inherit
}

body:json {
  {
    "orderId": {{order_id}},
    "plannedDate": "2026-08-15T00:00:00Z",
    "quantityPlanned": "100.000",
    "dtmStatus": "PENDING"
  }
}

vars:post-response {
  program_id: res.body.id
}

example {
  name: 201 Response
  
  request: {
    url: {{baseUrl}}/programs
    method: POST
    mode: json
    body:json: {
      {
        "orderId": 0,
        "plannedDate": "",
        "quantityPlanned": "",
        "quantityRealized": "",
        "dtmStatus": ""
      }
    }
  }
  
  response: {
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
