meta {
  name: create
  type: http
  seq: 1
  tags: [
    Customers
  ]
}

post {
  url: {{baseUrl}}/customers
  body: json
  auth: inherit
}

body:json {
  {
    "companyName": "ONCF Logistics",
    "address": "123 Railway Avenue",
    "city": "Casablanca",
    "phone": "+212522123456",
    "email": "contact@oncf.ma",
    "typeId": 1,
    "customerCode": "CUST-001",
    "isActive": true
  }
}

vars:post-response {
  customer_id: res.body.id
}

example {
  name: 201 Response
  
  request: {
    url: {{baseUrl}}/customers
    method: POST
    mode: json
    body:json: {
      {
        "companyName": "",
        "address": "",
        "city": "",
        "phone": "",
        "email": "",
        "typeId": 0,
        "customerCode": "",
        "isActive": false
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {}
      '''
    }
  }
}
