{
	"$schema": "https://turborepo.dev/schema.json",
	"ui": "tui",
	"globalPassThroughEnv": [
		"ECOMMAND_E2E_POSTGRES_PORT",
		"ECOMMAND_E2E_OBJECT_STORAGE_PORT",
		"ECOMMAND_E2E_NODE"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"env": ["NEXT_BUILD_DIST_DIR"],
			"outputs": [
				"dist/**",
				".next/**",
				".next-verify/**",
				"!.next/cache/**",
				"!.next/dev/**",
				"!.next-verify/cache/**"
			]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"typecheck": {
			"dependsOn": ["^build", "^typecheck"]
		},
		"test": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"dev": {
			"cache": false,
			"persistent": true,
			"passThroughEnv": ["BACKEND_API_URL"]
		},
		"dev:light": {
			"cache": false,
			"persistent": true,
			"passThroughEnv": ["BACKEND_API_URL"]
		},
		"//#format-and-lint": {},
		"//#format-and-lint:fix": {
			"cache": false
		}
	}
}
