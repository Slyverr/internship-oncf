{
	"name": "ecommand",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"dev:light": "turbo run dev:light",
		"typecheck": "turbo run typecheck",
		"format-and-lint": "biome check .",
		"format-and-lint:fix": "biome check . --write",
		"test": "turbo run test",
		"verify": "bun run format-and-lint && bun run typecheck && bun run test && bun run build",
		"verify:commit": "bun run verify",
		"ui:review": "bun scripts/capture-ui-review.ts",
		"test:e2e:api": "bun run --filter ecommand-api test:e2e"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.5",
		"turbo": "^2.11.5",
		"typescript": "5.9.2"
	},
	"engines": {
		"node": ">=18"
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "1.4.2"
		}
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	]
}
