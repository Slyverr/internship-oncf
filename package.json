{
	"name": "ecommand",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"check-types": "turbo run check-types",

		"format-and-lint": "biome check .",
		"format-and-lint:fix": "biome check . --write"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.5",
		"turbo": "^2.10.7",
		"typescript": "5.9.2"
	},
	"engines": {
		"node": ">=18"
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "1.3.13"
		}
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	]
}
