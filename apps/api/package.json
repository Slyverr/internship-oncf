{
	"name": "ecommand-api",
	"version": "0.0.1",
	"description": "",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"scripts": {
		"build": "NODE_PATH=./node_modules nest build",
		"dev": "NODE_PATH=./node_modules TS_NODE_PROJECT=./tsconfig.runtime.json nest start --watch",
		"dev:light": "NODE_PATH=./node_modules TS_NODE_PROJECT=./tsconfig.runtime.json nest start",
		"typecheck": "tsc --noEmit",
		"start": "NODE_PATH=./node_modules TS_NODE_PROJECT=./tsconfig.runtime.json nest start",
		"start:dev": "NODE_PATH=./node_modules TS_NODE_PROJECT=./tsconfig.runtime.json nest start --watch",
		"start:debug": "NODE_PATH=./node_modules TS_NODE_PROJECT=./tsconfig.runtime.json nest start --debug --watch",
		"start:prod": "NODE_PATH=./node_modules TS_NODE_PROJECT=./tsconfig.runtime.json node -r tsconfig-paths/register dist/src/main",
		"db:push": "NODE_PATH=./node_modules drizzle-kit push",
		"db:studio": "NODE_PATH=./node_modules drizzle-kit studio",
		"seed:dev": "tsx ./drizzle/seed/seed-dev.ts",
		"seed:ref": "tsx ./drizzle/seed/seed-ref.ts",
		"seed": "tsx ./drizzle/seed/seed-ref.ts && tsx ./drizzle/seed/seed-dev.ts",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"test:e2e": "bun ../../scripts/run-api-e2e.ts",
		"seed:e2e": "tsx ./test/fixtures/seed-e2e.ts",
		"test:e2e:jest": "node ../../node_modules/jest/bin/jest.js --config ./test/jest-e2e.json --runInBand",
		"wait:e2e-services": "tsx ./test/helpers/wait-for-e2e-services.ts"
	},
	"dependencies": {
		"@ecommand/shared": "workspace:*",
		"@nestjs/common": "11.1.28",
		"@nestjs/config": "^4.0.4",
		"@nestjs/core": "11.1.28",
		"@nestjs/jwt": "^11.0.2",
		"@nestjs/passport": "^11.0.5",
		"@nestjs/platform-express": "11.1.28",
		"@nestjs/swagger": "11.4.6",
		"@types/minio": "^7.1.1",
		"@types/passport-local": "^1.0.38",
		"bcryptjs": "^3.0.3",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^1.0.0-rc.5-ab785fc",
		"minio": "^8.0.7",
		"nanoid": "^6.0.1",
		"nodemailer": "^10.0.12",
		"passport": "^0.7.0",
		"passport-jwt": "^4.0.1",
		"passport-local": "^1.0.0",
		"pg": "^8.23.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"uuid": "^14.0.2"
	},
	"devDependencies": {
		"@nestjs/cli": "11.0.24",
		"@nestjs/schematics": "11.1.0",
		"@nestjs/testing": "11.1.28",
		"@types/express": "^5.0.6",
		"@types/jest": "^30.0.0",
		"@types/node": "^24.19.0",
		"@types/nodemailer": "^8.0.2",
		"@types/passport-jwt": "^4.0.1",
		"@types/pg": "^8.23.1",
		"@types/supertest": "^7.2.1",
		"drizzle-kit": "^1.0.0-rc.5-ab785fc",
		"jest": "^30.5.2",
		"source-map-support": "^0.5.21",
		"supertest": "^7.3.0",
		"ts-jest": "^29.4.14",
		"ts-loader": "^9.6.2",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"tsx": "^4.23.15",
		"typescript": "5.9.2"
	}
}
