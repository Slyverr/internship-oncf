{
	"moduleFileExtensions": ["js", "json", "ts"],
	"rootDir": "..",
	"testEnvironment": "node",
	"testRegex": "test/.*\\.e2e-spec.ts$",
	"transform": {
		"^.+\\.(t|j)s$": "ts-jest"
	},
	"moduleNameMapper": {
		"^@/(.*)$": "<rootDir>/src/$1",
		"^src/(.*)$": "<rootDir>/src/$1",
		"^drizzle/(.*)$": "<rootDir>/drizzle/$1"
	}
}
