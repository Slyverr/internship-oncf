# NestJS
NESTJS_PORT=8000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommand

# JWT
JWT_SECRET=replace-with-a-random-secret
JWT_EXPIRES_IN=30m
WEB_APP_URL=http://localhost:3000

# Lock an active account after repeated failed passwords. Defaults: 5 attempts,
# 15 minutes. Values must be positive integers; max supported is 100 attempts
# and 7 days (604800 seconds).
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_LOCK_DURATION_SECONDS=900

# Development-only DTM simulation. It never contacts an ONCF endpoint.
# `manual` leaves requests pending until an admin resolves them on the DTM page;
# `auto` applies the configured delayed response. Manual is the default.
DTM_MODE=simulator
DTM_SIMULATOR_RESPONSE_MODE=manual
# Auto response delay in seconds; accepts 0-60 (0 responds immediately).
DTM_SIMULATOR_DELAY_SECONDS=2
DTM_SIMULATOR_RESULT=ACCEPTED

# Optional SMTP provider. When SMTP_HOST and SMTP_FROM are configured, reset
# emails are sent through SMTP. SMTP_USER and SMTP_PASSWORD must be set together.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Used when SMTP settings are absent or incomplete.
LOCAL_MAILBOX_PATH=./.local-mailbox

# S3-compatible object storage (SeaweedFS locally)
OBJECT_STORAGE_ENDPOINT=http://localhost:8333
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=ecommandlocal
OBJECT_STORAGE_SECRET_KEY=ecommand-local-secret
OBJECT_STORAGE_BUCKET=ecommand

# Storage (fallback)
STORAGE_PATH=./uploads
